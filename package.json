{
  "name": "@trussium/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for an existing Trussium runtime.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "build:examples": "npm run build && tsc --project examples/tsconfig.json",
    "test": "npm run build && node --test test/client.test.mjs",
    "release": "semantic-release"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "semantic-release": "^26.0.1",
    "typescript": "^7.0.2"
  }
}
