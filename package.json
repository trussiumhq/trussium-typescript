{
  "name": "@trussium/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for an existing Trussium runtime.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
